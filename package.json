{
  "name": "llm-observability-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted LLM observability and eval dashboard: OTLP GenAI ingest, evals, drift, alerting.",
  "license": "MIT",
  "author": "Pedro Monteiro",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --import tsx src/cli/dev.ts",
    "ingress": "node --import tsx src/cli/serve.ts",
    "dashboard": "next dev",
    "build": "next build",
    "start": "next start",
    "seed": "node --import tsx src/cli/seed.ts",
    "demo": "node --import tsx src/cli/demo-regression.ts",
    "loadtest": "node --import tsx src/cli/loadtest.ts",
    "drift": "node --import tsx src/cli/drift.ts",
    "eval-report": "node --import tsx src/cli/eval-report.ts",
    "emit": "node --import tsx src/cli/emit.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-is": "19.1.1",
    "recharts": "3.11.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
