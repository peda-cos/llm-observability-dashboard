# Local trace + metadata store
OBS_DB=./data/obs.db
OBS_PORT=4318
HOST=127.0.0.1
ARCHIVE_DIR=./data/archive
POLICY_PATH=./config/policy.json
PRICING_PATH=./config/pricing.json

# Capture prompts/completions locally so evals and PII detection can run.
# Set to 0 for hash-only telemetry.
CAPTURE_CONTENT=1
LOG_LEVEL=info

# Optional production ClickHouse exporter (HTTP interface)
CLICKHOUSE_URL=
CLICKHOUSE_DATABASE=observability
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=

# Optional alert delivery. Without these, alerts are local-only.
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=

# Optional real guard judge. The default is a deterministic local detector.
JUDGE_PROVIDER=local
OPENAI_BASE_URL=
OPENAI_API_KEY=sk_test_only
JUDGE_MODEL=
